{
  "collectionName": "components_home_cards",
  "info": {
    "displayName": "Card"
  },
  "options": {},
  "attributes": {
    "Image": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "Title": {
      "type": "string"
    },
    "Description": {
      "type": "text"
    },
    "Btn_txt": {
      "type": "string"
    },
    "Btn_txt2": {
      "type": "string"
    },
    "LongDescription": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    },
    "Thumbnail": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "Url": {
      "type": "text"
    },
    "course_list": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::course-list.course-list"
    },
    "Slug": {
      "type": "string"
    }
  },
  "config": {}
}
