{
  "kind": "collectionType",
  "collectionName": "course_lists",
  "info": {
    "singularName": "course-list",
    "pluralName": "course-lists",
    "displayName": "CourseList"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Name": {
      "type": "string"
    },
    "Slug": {
      "type": "string",
      "unique": true
    },
    "admissions": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::admission.admission",
      "mappedBy": "Course"
    },
    "Amount": {
      "type": "decimal",
      "min": 1,
      "max": 100000
    },
    "Percentage": {
      "type": "decimal",
      "min": 1,
      "max": 10000
    }
  }
}
