{
  "kind": "collectionType",
  "collectionName": "admissions",
  "info": {
    "singularName": "admission",
    "pluralName": "admissions",
    "displayName": "Admission"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name_title": {
      "type": "enumeration",
      "required": false,
      "enum": [
        "Mr.",
        "Ms.",
        "Mrs."
      ]
    },
    "first_name": {
      "type": "string",
      "required": true
    },
    "last_name": {
      "type": "string",
      "required": false
    },
    "date_of_birth": {
      "type": "date",
      "required": false
    },
    "nationality": {
      "type": "string",
      "required": false
    },
    "passport_size_image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "mobile_no": {
      "type": "biginteger",
      "required": true
    },
    "email": {
      "type": "email",
      "required": true,
      "unique": false
    },
    "Language_Proficiency": {
      "type": "component",
      "component": "language-and-proficiency.language-proficiency",
      "repeatable": true
    },
    "address": {
      "type": "blocks"
    },
    "city": {
      "type": "string"
    },
    "district": {
      "type": "string"
    },
    "state": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::state.state",
      "inversedBy": "admissions"
    },
    "pincode": {
      "type": "string"
    },
    "hobbies": {
      "type": "string"
    },
    "photography_club": {
      "type": "string"
    },
    "blood_group": {
      "type": "string"
    },
    "Parent_Guardian_Spouse_Details": {
      "type": "component",
      "component": "parent-guardian-spouse.parent-guardian-spouse-details",
      "repeatable": false
    },
    "step_1": {
      "type": "boolean",
      "default": false
    },
    "Education_Details": {
      "type": "component",
      "component": "education-details.education-details",
      "repeatable": false
    },
    "Under_Graduate": {
      "type": "component",
      "component": "under-graduate.under-graduate",
      "repeatable": false
    },
    "Post_Graduate": {
      "type": "component",
      "component": "post-graduate.post-graduate",
      "repeatable": true
    },
    "Work_Experience": {
      "type": "component",
      "component": "work-experience.work-experience",
      "repeatable": true
    },
    "step_2": {
      "type": "boolean",
      "default": false
    },
    "Upload_Your_Portfolio": {
      "type": "component",
      "component": "upload-your-portfolio.upload-your-portfolio",
      "repeatable": false
    },
    "step_3": {
      "type": "boolean",
      "default": false
    },
    "Payment_Status": {
      "type": "enumeration",
      "default": "Pending",
      "enum": [
        "Paid",
        "UnPaid",
        "Completed",
        "Pending",
        "Failed"
      ]
    },
    "step_0": {
      "type": "boolean",
      "default": false
    },
    "Message": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    },
    "Course": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::course-list.course-list",
      "inversedBy": "admissions"
    },
    "Paid_Amount": {
      "type": "decimal"
    },
    "EncryptId": {
      "type": "string"
    },
    "txnid": {
      "type": "string"
    },
    "PayUId": {
      "type": "string"
    },
    "payment_response": {
      "type": "json"
    },
    "mihpayid": {
      "type": "string"
    },
    "AdmissionYear": {
      "type": "string"
    },
    "IpAddress": {
      "type": "string"
    },
    "step_4": {
      "type": "boolean",
      "default": false
    },
    "Currentstep": {
      "type": "string"
    },
    "captchaToken": {
      "type": "text"
    }
  }
}
